[mysqld]
# MYROBOOT production-oriented MySQL 8 settings.
# Keep this file on the host and mount it read-only into the container.
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci

# Durability: commit is acknowledged only after redo/binlog are flushed.
innodb_flush_log_at_trx_commit=1
sync_binlog=1

# Keep binary logs for point-in-time recovery for 7 days.
server-id=1
log_bin=mysql-bin
binlog_format=ROW
binlog_expire_logs_seconds=604800

# Operational safety / compatibility.
max_connections=200
max_allowed_packet=256M
skip_name_resolve=ON

[client]
default-character-set=utf8mb4
