# SMTP 邮箱配置示例
# 复制本文件为 .env，然后填写你自己的邮箱 SMTP 信息。
# 不要把真实邮箱密码/授权码提交到 GitHub。

MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=support@example.com
MAIL_PASSWORD=replace-with-smtp-app-password
MAIL_FROM=support@example.com
MAIL_SMTP_AUTH=true
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false

# 如果你的邮箱服务商要求 587 + STARTTLS，可改为：
# MAIL_PORT=587
# MAIL_SSL_ENABLE=false
# MAIL_STARTTLS_ENABLE=true
