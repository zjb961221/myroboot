# 复制本文件为 .env 后再修改。
# 不要把真实密码、授权码、Token 提交到 GitHub。

# ===== 基础端口 / 监听地址 =====
# 默认只对外开放前端 8088；MySQL 和后端 API 仅本机可访问。
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=8088
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3306

# 对外访问技术支持平台的完整地址，用于邮件中的“直接查看/处理”链接。
# 无域名时可先写 http://服务器IP:8088；正式 HTTPS 后建议改为域名。
SUPPORT_PUBLIC_BASE_URL=http://your-server-ip:8088

# ===== 主机持久化路径 =====
# 所有不可再生的运行数据改为宿主机 bind mount，不再只存在 Docker named volume 中。
# 建议生产机使用独立数据盘绝对路径，例如 /data/myroboot。
# 使用相对路径时默认落在项目目录 ./data。
DATA_ROOT=./data
# 手工备份脚本默认写入 ./backups；可改到另一块磁盘。
BACKUP_ROOT=./backups

# ===== MySQL =====
MYSQL_DATABASE=myroboot
MYSQL_ROOT_PASSWORD=replace-with-strong-database-password
DB_POOL_MAX=20
DB_POOL_MIN=3

# ===== 初始账号 / 登录会话 =====
# 首次部署请务必修改默认密码。已经创建的数据库用户不会因为这里修改而自动改密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
CUSTOMER_USERNAME=customer
CUSTOMER_PASSWORD=replace-with-customer-password
# 登录会话默认 168 小时（7 天）
AUTH_SESSION_HOURS=168
# 本地 HTTP 保持 false；正式启用 HTTPS 后必须设置为 true。
SESSION_COOKIE_SECURE=false

# ===== 上传文件 =====
# 未被问题库/工单引用的临时上传文件，超过该时间后自动清理。
UPLOAD_CLEANUP_GRACE_HOURS=24

# ===== SMTP 邮箱 =====
# QQ 邮箱发送邮件必须使用 smtp.qq.com，不要使用 imap.qq.com。
# 注册验证码、工单分配和工单完成通知共用这一套 SMTP 配置。
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your@qq.com
MAIL_PASSWORD=replace-with-qq-smtp-authorization-code
MAIL_FROM=your@qq.com
MAIL_SMTP_AUTH=true
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false

# 如果其他邮箱服务商要求 587 + STARTTLS，可改为：
# MAIL_PORT=587
# MAIL_SSL_ENABLE=false
# MAIL_STARTTLS_ENABLE=true
