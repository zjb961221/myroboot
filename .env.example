# SMTP 邮箱配置示例
# 复制本文件为 .env，然后填写你自己的 SMTP 信息。
# 不要把真实邮箱密码/授权码提交到 GitHub。

# QQ 邮箱示例：发送邮件必须使用 smtp.qq.com，不要使用 imap.qq.com
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your@qq.com
MAIL_PASSWORD=replace-with-qq-smtp-authorization-code
MAIL_FROM=your@qq.com
MAIL_SMTP_AUTH=true
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false

# 如果其他邮箱服务商要求 587 + STARTTLS，可改为：
# MAIL_PORT=587
# MAIL_SSL_ENABLE=false
# MAIL_STARTTLS_ENABLE=true
