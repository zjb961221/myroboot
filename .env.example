# 复制本文件为 .env 后再修改。
# 不要把真实密码、授权码、Token 提交到 GitHub。
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=8088
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3306
SUPPORT_PUBLIC_BASE_URL=http://your-server-ip:8088
DATA_ROOT=./data
BACKUP_ROOT=./backups
MYSQL_DATABASE=myroboot
MYSQL_ROOT_PASSWORD=replace-with-strong-database-password
DB_POOL_MAX=20
DB_POOL_MIN=3
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
CUSTOMER_USERNAME=customer
CUSTOMER_PASSWORD=replace-with-customer-password
AUTH_SESSION_HOURS=168
SESSION_COOKIE_SECURE=false
UPLOAD_CLEANUP_GRACE_HOURS=24

# SMTP：验证码、工单通知、权限审批通知共用。
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your@qq.com
MAIL_PASSWORD=replace-with-qq-smtp-authorization-code
MAIL_FROM=your@qq.com
MAIL_SMTP_AUTH=true
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# GNOME 远程桌面网关：32 位十六进制随机密钥，MYROBOOT 与 Guacamole 共用。
# 例如：openssl rand -hex 16
# 绝对不要提交真实密钥。
GUAC_JSON_SECRET_KEY=replace-with-32-hex-random-secret
